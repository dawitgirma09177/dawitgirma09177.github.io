<!-- AUTOMATIC CV PDF GENERATOR -->
<script>
function generateCV() {

    if (!window.jspdf || !window.jspdf.jsPDF) {
        alert("The PDF library could not load. Please check your internet connection and try again.");
        return;
    }

    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF("p", "mm", "a4");

    const left = 18;
    const width = 174;
    const pageHeight = 297;
    const bottomMargin = 18;
    let y = 20;

    function checkPage(heightNeeded) {
        if (y + heightNeeded > pageHeight - bottomMargin) {
            pdf.addPage();
            y = 20;
        }
    }

    function heading(text) {
        checkPage(14);
        y += 4;
        pdf.setFont("helvetica", "bold");
        pdf.setFontSize(12);
        pdf.setTextColor(22, 59, 101);
        pdf.text(text, left, y);
        y += 3;
        pdf.setDrawColor(36, 91, 145);
        pdf.line(left, y, 192, y);
        y += 6;
    }

    function paragraph(text, size = 9) {
        pdf.setFont("helvetica", "normal");
        pdf.setFontSize(size);
        pdf.setTextColor(40, 52, 69);

        const lines = pdf.splitTextToSize(text, width);
        const lineHeight = size * 0.48 + 1.5;

        lines.forEach(line => {
            checkPage(lineHeight);
            pdf.text(line, left, y);
            y += lineHeight;
        });

        y += 2;
    }

    function boldParagraph(title, detail) {
        checkPage(14);
        pdf.setFont("helvetica", "bold");
        pdf.setFontSize(9);
        pdf.setTextColor(38, 52, 69);

        const titleLines = pdf.splitTextToSize(title, width);
        titleLines.forEach(line => {
            checkPage(5);
            pdf.text(line, left, y);
            y += 5;
        });

        if (detail) {
            paragraph(detail, 8.5);
        }
    }

    // NAME
    pdf.setFont("helvetica", "bold");
    pdf.setFontSize(20);
    pdf.setTextColor(22, 59, 101);
    pdf.text("DAWIT GIRMA BUAYU", left, y);
    y += 8;

    pdf.setFont("helvetica", "bold");
    pdf.setFontSize(10);
    pdf.setTextColor(36, 91, 145);
    pdf.text("Lecturer and Researcher | Water Resources Engineering", left, y);
    y += 7;

    paragraph(
        "Department of Civil Engineering, Wolkite University, Ethiopia\n" +
        "Professional email: dawit.girma@wku.edu.et\n" +
        "Alternative email: davegirma63@gmail.com\n" +
        "Academic portfolio: https://dawitgirma09177.github.io",
        8
    );

    heading("PROFESSIONAL PROFILE");
    paragraph(
        "Lecturer and researcher at Wolkite University, Ethiopia, with an M.Sc. " +
        "in Civil Engineering (Hydraulic Engineering). Research and professional " +
        "interests include hydrology, hydrological modelling, hydraulic engineering, " +
        "water resources management, climate change and water resources, groundwater, " +
        "flood risk management, irrigation and drainage engineering, GIS and remote " +
        "sensing, and applications of artificial intelligence in water resources planning."
    );

    heading("EDUCATION");
    boldParagraph(
        "M.Sc. in Civil Engineering (Hydraulic Engineering)",
        "Addis Ababa University, Ethiopia — 2021."
    );
    boldParagraph(
        "B.Sc. in Hydraulic and Water Resources Engineering",
        "Wollega University, Ethiopia — 2016."
    );

    heading("ACADEMIC APPOINTMENT");
    boldParagraph(
        "Lecturer and Researcher — Wolkite University, Ethiopia",
        "September 14, 2017 – Present. Teaching and research in Hydraulic and Water Resources Engineering, Civil Engineering, and Construction Technology and Management (COTM)."
    );

    heading("PROFESSIONAL ENGINEERING EXPERIENCE");
    boldParagraph(
        "Part-time Site and Office Engineer — GMN Water Works Construction Plc.",
        "March 01, 2022 – September 13, 2025."
    );
    boldParagraph(
        "Part-time Site and Office Engineer — Etenesh Abebaw WWC",
        "January 02, 2017 – February 05, 2022."
    );
    paragraph(
        "Professional experience includes engineering documentation, design review, " +
        "AutoCAD drawings, engineering layouts, design calculations, preparation of " +
        "Bills of Quantities (BOQ), cost estimates, material take-offs, site supervision, " +
        "quality control, construction management, technical problem-solving, quantity " +
        "measurements, and coordination with contractors, subcontractors and suppliers."
    );

    heading("RESEARCH INTERESTS");

    [
        "Hydrology and Hydrological Modeling",
        "Water Resources Management",
        "Climate Change and Water Resources",
        "Groundwater",
        "Flood Risk Management",
        "Irrigation and Drainage Engineering",
        "GIS and Remote Sensing Applications",
        "Applications of AI in Water Resources Planning and Management"
    ].forEach(function(value) {
        paragraph("• " + value, 9);
    });

    heading("TECHNICAL AND PROFESSIONAL SKILLS");
    paragraph(
        "Hydraulic and water resources engineering; hydrological analysis and modelling; " +
        "GIS and remote sensing; AutoCAD drawings and engineering layouts; engineering " +
        "design calculations; BOQ preparation; cost estimation; material take-offs; " +
        "site supervision; quality control; construction management; technical documentation."
    );

    heading("RESEARCH PUBLICATIONS");

    const publications = [
        "Performance evaluation of high-resolution multiple satellite rainfall estimates for drought and flood monitoring in the Omo-Gibe Basin, Ethiopia. H2Open Journal, 2026. https://doi.org/10.1016/j.htopen.2026.100014",
        "Geospatial mapping of groundwater potential zones using multi-criteria decision analysis and GIS fuzzy logic in Dabus Sub-Basin, western Ethiopia. Quaternary Science Advances, 2025. https://doi.org/10.1016/j.qsa.2025.100275",
        "MCDA Approach for Identification of Rainwater Harvesting Site in Drought Vulnerable Area of Genale Dawa River Basin, Southern Ethiopia. Hydrospatial Analysis, 2025. DOI requires verification.",
        "Identifying flood vulnerable and risk areas using the integration of analytical hierarchy process (AHP), GIS, and remote sensing: A case study of southern Oromia region. 2023. https://doi.org/10.1016/j.uclim.2023.101640",
        "Site Suitability Analysis for Surface Irrigation using GIS, Remote Sensing, and Analytical Hierarchy Process (AHP) Integration in Wama Watershed, Western Ethiopia. Hydrospatial Analysis, 2022. https://doi.org/10.21523/gcj3.2022060104",
        "Estimation of Soil Loss Rate Using RUSLE Model Integrated with GIS and Remote Sensing Techniques: The Case of Wama Watershed, Western Ethiopia. International Journal of Scientific Research and Innovative Studies, 2022. https://ijsrisjournal.com/index.php/ojsfiles/article/view/22",
        "Identification of Groundwater Potential Zones Using AHP, GIS and RS Integration: A Case Study of Didessa Sub-Basin, Western Ethiopia. 2022. https://doi.org/10.21523/gcj1.2022060101",
        "Evaluation and Bias correction of Tropical Applications of Meteorology using SATellite (TAMSAT) daily rainfall estimates over the data-scarce region of Southern Ethiopia. Journal of Civil Engineering Research & Technology, 2021. https://doi.org/10.47363/JCERT/2021(3)121",
        "Evaluation of the performance of high-resolution rainfall products for stream flow Simulation. Journal of Civil & Environmental Engineering, 2021. https://doi.org/10.37421/2165-784X.2021.11.383"
    ];

    publications.forEach(function(publication, index) {
        paragraph((index + 1) + ". " + publication, 8);
    });

    heading("REFERENCES");
    paragraph("Professional references are available upon request.");

    // PAGE NUMBERS
    const totalPages = pdf.internal.getNumberOfPages();

    for (let page = 1; page <= totalPages; page++) {
        pdf.setPage(page);
        pdf.setFont("helvetica", "normal");
        pdf.setFontSize(8);
        pdf.setTextColor(100, 100, 100);
        pdf.text(
            "Dawit Girma Buayu | Academic CV | Page " + page + " of " + totalPages,
            18,
            289
        );
    }

    // DOWNLOAD THE GENERATED PDF
    pdf.save("Dawit_Girma_Buayu_CV.pdf");
}
</script>

</body>
</html>
