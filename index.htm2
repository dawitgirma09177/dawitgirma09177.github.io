
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dawit Girma Buayu | Academic Portfolio</title>

<meta name="description" content="Academic and professional portfolio of Dawit Girma Buayu, Lecturer and Researcher in Water Resources Engineering at Wolkite University, Ethiopia.">

<style>
:root {
  --navy: #123047;
  --blue: #176b87;
  --light-blue: #eaf3f7;
  --background: #f5f8fa;
  --white: #ffffff;
  --text: #293744;
  --muted: #647582;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.7;
  background: var(--background);
  color: var(--text);
}

/* NAVIGATION */

header {
  background: var(--navy);
  padding: 15px 6%;
  position: sticky;
  top: 0;
  z-index: 100;
}

nav {
  max-width: 1200px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.logo {
  color: white;
  font-size: 21px;
  font-weight: bold;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  list-style: none;
}

nav a {
  color: white;
  text-decoration: none;
  font-size: 14px;
}

nav a:hover {
  color: #a9d9eb;
}

/* HERO / PROFILE SECTION */

.hero {
  background: linear-gradient(135deg, #123047, #176b87);
  color: white;
  padding: 70px 6%;
}

.hero-content {
  max-width: 1150px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 45px;
  flex-wrap: nowrap;
}

.profile {
  width: 210px;
  height: 210px;
  min-width: 210px;
  border-radius: 50%;
  object-fit: cover;
  object-position: center;
  display: block;
  flex-shrink: 0;
  border: 5px solid white;
}

.hero-text {
  flex: 1;
  min-width: 0;
  color: white;
  display: block;
}

.hero-text h1 {
  color: white;
  font-size: 38px;
  line-height: 1.3;
  margin-bottom: 10px;
}

.hero-text h2 {
  color: #d8edf5;
  font-size: 21px;
  font-weight: normal;
  margin-bottom: 15px;
}

.hero-text p {
  color: white;
  margin-bottom: 20px;
}

.button {
  display: inline-block;
  background: white;
  color: var(--navy);
  padding: 10px 22px;
  border-radius: 5px;
  text-decoration: none;
  font-weight: bold;
  margin: 5px 8px 5px 0;
}

.button:hover {
  background: #d8edf5;
}

/* MAIN CONTENT */

main {
  max-width: 1100px;
  margin: auto;
  padding: 30px 20px;
}

section {
  background: white;
  padding: 30px;
  margin-bottom: 25px;
  border-radius: 9px;
  box-shadow: 0 3px 12px rgba(0,0,0,.05);
  scroll-margin-top: 90px;
}

section h2 {
  color: var(--navy);
  font-size: 25px;
  border-bottom: 3px solid var(--blue);
  padding-bottom: 10px;
  margin-bottom: 20px;
}

h3 {
  color: var(--blue);
  margin-top: 18px;
  margin-bottom: 7px;
}

p {
  margin-bottom: 12px;
}

ul, ol {
  padding-left: 24px;
}

li {
  margin-bottom: 9px;
}

.publication-list li {
  margin-bottom: 18px;
}

.publication-list a,
.contact-links a {
  color: var(--blue);
  text-decoration: none;
}

.publication-list a:hover,
.contact-links a:hover {
  text-decoration: underline;
}

.date {
  color: var(--muted);
  font-size: 14px;
}

footer {
  background: var(--navy);
  color: white;
  text-align: center;
  padding: 25px 15px;
  margin-top: 30px;
}

/* MOBILE RESPONSIVE DESIGN */

@media (max-width: 750px) {

  header {
    position: static;
  }

  nav {
    justify-content: center;
  }

  nav ul {
    justify-content: center;
  }

  .hero {
    padding: 45px 6%;
  }

  .hero-content {
    flex-direction: column;
    flex-wrap: wrap;
    text-align: center;
    gap: 25px;
  }

  .profile {
    width: 180px;
    height: 180px;
    min-width: 180px;
  }

  .hero-text {
    width: 100%;
  }

  .hero-text h1 {
    font-size: 29px;
  }

  .hero-text h2 {
    font-size: 18px;
  }

  section {
    padding: 22px;
  }

}

</style>
</head>

