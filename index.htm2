    <p class="date">2021</p>
    <p>Addis Ababa University, Ethiopia.</p>
  </div>

  <div class="item">
    <h3>B.Sc. in Hydraulic and Water Resources Engineering</h3>
    <p class="date">2016</p>
    <p>Wollega University, Ethiopia.</p>
  </div>
</section>

