<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Academic and professional portfolio of Dawit Girma Buayu, Lecturer and Researcher in Water Resources Engineering at Wolkite University, Ethiopia.">
  <title>Dawit Girma Buayu | Academic Portfolio</title>

  <!-- Font Awesome icons -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>
    :root {
      --navy: #10243a;
      --blue: #174a75;
      --teal: #0d9488;
      --light: #f3f7fb;
      --white: #ffffff;
      --text: #263445;
      --muted: #64748b;
      --border: #e2e8f0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--light);
      color: var(--text);
      line-height: 1.7;
    }

    a {
      color: var(--teal);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    header {
      background: var(--navy);
      color: white;
      padding: 16px 7%;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 12px rgba(0,0,0,.15);
    }

    nav {
      max-width: 1200px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 19px;
      font-weight: bold;
      color: white;
    }

    .nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 17px;
      list-style: none;
    }

    .nav-links a {
      color: white;
      font-size: 13px;
    }

    .hero {
      background: linear-gradient(135deg, #10243a, #174a75);
      color: white;
      padding: 85px 7%;
    }

    .hero-content {
      max-width: 1100px;
      margin: auto;
    }

    .hero h1 {
      font-size: clamp(32px, 5vw, 48px);
      line-height: 1.2;
      margin-bottom: 15px;
    }

    .hero h2 {
      color: #8ee3d7;
      font-size: 22px;
      font-weight: 500;
      margin-bottom: 20px;
    }

    .hero p {
      max-width: 800px;
      color: #e2eaf3;
      font-size: 16px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .btn {
      display: inline-block;
      padding: 11px 20px;
      border-radius: 7px;
      font-weight: bold;
      font-size: 14px;
      background: var(--teal);
      color: white;
      border: 1px solid var(--teal);
      cursor: pointer;
    }

    .btn:hover {
      background: #087c73;
      text-decoration: none;
    }

    .btn-outline {
      background: transparent;
      border-color: white;
      color: white;
    }

    main {
      max-width: 1150px;
      margin: auto;
      padding: 35px 22px 70px;
    }

    section {
      background: white;
      padding: 32px;
      margin: 25px 0;
      border-radius: 12px;
      box-shadow: 0 3px 15px rgba(15, 35, 55, .05);
      scroll-margin-top: 85px;
    }

    .section-title {
      font-size: 25px;
      color: var(--navy);
      margin-bottom: 22px;
      padding-bottom: 10px;
      border-bottom: 3px solid var(--teal);
      display: inline-block;
    }

    .section-intro {
      color: var(--muted);
      margin-bottom: 20px;
    }

    .item {
      margin-bottom: 22px;
      padding-left: 18px;
      border-left: 3px solid var(--teal);
    }

    .item h3 {
      color: var(--blue);
      font-size: 17px;
      margin-bottom: 4px;
    }

    .date {
      font-size: 13px;
      color: var(--muted);
      font-weight: bold;
      margin-bottom: 7px;
    }

    ul.detail-list {
      padding-left: 22px;
      margin-top: 8px;
    }

    ul.detail-list li {
      margin-bottom: 6px;
    }

    .research-grid,
    .skills-grid,
    .cert-grid,
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
    }

    .research-card,
    .skill-card,
    .cert-card,
    .contact-card {
      border: 1px solid var(--border);
      padding: 18px;
      border-radius: 10px;
      background: #fff;
      transition: transform .2s, box-shadow .2s;
    }

    .research-card:hover,
    .skill-card:hover,
    .cert-card:hover,
    .contact-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 7px 18px rgba(15, 35, 55, .09);
    }

    .research-card i,
    .cert-card i {
      font-size: 25px;
      color: var(--teal);
      margin-bottom: 10px;
    }

    .skill-card {
      text-align: center;
    }

    .skill-icon {
      width: 58px;
      height: 58px;
      margin: 0 auto 12px;
      border-radius: 14px;
      background: #e7f5f4;
      color: var(--blue);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 25px;
    }

    .skill-icon .short-logo {
      font-weight: bold;
      font-size: 17px;
      letter-spacing: -1px;
    }

    .skill-card h3 {
      font-size: 15px;
      color: var(--navy);
    }

    .skill-category {
      color: var(--teal);
      font-size: 13px;
      font-weight: bold;
      margin: 24px 0 12px;
    }

    .publication {
      padding: 17px 0;
      border-bottom: 1px solid var(--border);
    }

    .publication:last-child {
      border-bottom: none;
    }

    .publication h3 {
      font-size: 16px;
      color: var(--blue);
      margin-bottom: 6px;
    }

    .publication p {
      font-size: 14px;
      color: var(--muted);
    }

    .publication a {
      display: inline-block;
      margin-top: 5px;
      font-size: 14px;
      font-weight: bold;
    }

    .contact-card {
      display: flex;
      gap: 13px;
      align-items: flex-start;
      overflow-wrap: anywhere;
    }

    .contact-card i {
      color: var(--teal);
      font-size: 21px;
      width: 25px;
      text-align: center;
      margin-top: 3px;
    }

    .contact-card strong {
      display: block;
      color: var(--navy);
      margin-bottom: 3px;
    }

    .contact-card a,
    .contact-card span {
      font-size: 14px;
    }

    .note {
      color: var(--muted);
      font-size: 13px;
      margin-top: 18px;
    }

    footer {
      text-align: center;
      background: var(--navy);
      color: #dbe6ef;
      padding: 25px 15px;
      font-size: 13px;
    }

    @media (max-width: 700px) {
      header {
        position: static;
      }

      nav {
        align-items: flex-start;
      }

      .nav-links {
        gap: 10px 15px;
      }

      .hero {
        padding: 55px 7%;
      }

      section {
        padding: 23px 18px;
      }
    }

    @media print {
      header, .hero-buttons, footer {
        display: none !important;
      }

      body {
        background: white;
      }

      main {
        max-width: 100%;
        padding: 0;
      }

      section {
        box-shadow: none;
        break-inside: avoid;
        margin: 12px 0;
      }

      a {
        color: inherit;
      }
    }
  </style>
</head>

<body>

